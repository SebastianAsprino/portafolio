---
import { ClientRouter } from "astro:transitions";
// Fuentes pixel servidas desde el sitio (la CSP solo permite font-src 'self').
import "@fontsource/pixelify-sans/400.css";
import "@fontsource/pixelify-sans/700.css";
import "@fontsource/vt323/400.css";
import OceanBackground from "../components/OceanBackground.svelte";
import { person, website, LOCATION_LABEL, type JsonLdNode } from "../lib/seo";
interface Props {
	title?: string;
	description?: string;
	/** Páginas que no deben indexarse (404): agrega noindex y omite el canonical. */
	noindex?: boolean;
	/** Nodos JSON-LD propios de la página; WebSite y Person van siempre. */
	schema?: JsonLdNode[];
}

const {
	title = "Portafolio",
	description = `Desarrollador fullstack en ${LOCATION_LABEL}. Construyo software de principio a fin: APIs, bases de datos, interfaces y despliegue.`,
	noindex = false,
	schema = [],
} = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL("/og.jpg", Astro.site);
const jsonLd = JSON.stringify({
	"@context": "https://schema.org",
	"@graph": [website, person, ...schema],
});
---

<!doctype html>
<html lang="es">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<title>{title}</title>
		<meta name="description" content={description} />
		{noindex ? <meta name="robots" content="noindex" /> : <link rel="canonical" href={canonical} />}

		<meta property="og:type" content="website" />
		<meta property="og:locale" content="es_CO" />
		<meta property="og:site_name" content="Sebastian Asprino" />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:url" content={canonical} />
		<meta property="og:image" content={ogImage} />
		<meta property="og:image:width" content="1200" />
		<meta property="og:image:height" content="630" />
		<meta property="og:image:alt" content="Portafolio de Sebastian Asprino" />

		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:creator" content="@Seb_Asp" />
		<meta name="twitter:title" content={title} />
		<meta name="twitter:description" content={description} />
		<meta name="twitter:image" content={ogImage} />
		{!noindex && <script type="application/ld+json" is:inline set:html={jsonLd} />}
		<link rel="alternate" type="text/markdown" href="/llms.txt" title="llms.txt" />
		<link rel="icon" href="/favicon.ico" sizes="32x32" />
		<link rel="icon" href="/favicon.svg" type="image/svg+xml" />
		<link rel="apple-touch-icon" href="/apple-touch-icon.png" />
		<script
			is:inline
			src="https://rybbit.asprino.dev/api/script.js?siteId=675234c86381"
			defer></script>
		<script
			is:inline
			defer
			src="https://umami.asprino.dev/script.js"
			data-website-id="50baaba3-915b-4f01-8e78-e8b7805486e5"></script>
		<script
			is:inline
			defer
			src="https://umami.asprino.dev/recorder.js"
			data-website-id="50baaba3-915b-4f01-8e78-e8b7805486e5"></script>
		<ClientRouter />
	</head>
	<body>
		<OceanBackground client:only="svelte" transition:persist />
		<div class="overlay">
			<slot />
		</div>
	</body>
</html>

<style is:global>
	/* Pixelify Sans para títulos, nav y etiquetas; VT323 (terminal pixel)
	   para el texto. VT323 es chica para su tamaño nominal: los font-size del
	   sitio ya lo compensan. */
	:root {
		--font-pixel: "Pixelify Sans", "VT323", monospace;
		--font-text: "VT323", monospace;
	}

	* {
		margin: 0;
		padding: 0;
		box-sizing: border-box;
	}

	body {
		background: #000;
		min-height: 100vh;
		overflow-x: hidden;
		font-family: var(--font-text);
		-webkit-font-smoothing: antialiased;
	}

	button,
	input,
	select,
	textarea {
		font: inherit;
	}
</style>

<style>
	.overlay {
		position: relative;
		z-index: 1;
		min-height: 100vh;
	}
</style>
